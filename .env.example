# eBay Browse API — OPTIONAL. The app runs fully keyless on Google Trends + Prophet.
# Leave these blank to use the curated/estimated price index (modeled on real
# Google Trends demand). Add a production keyset from https://developer.ebay.com
# (App ID = Client ID, Cert ID = Client Secret) to enrich prices with LIVE eBay
# listings — `source` then flips from "estimate" to "ebay" automatically.
EBAY_APP_ID=
EBAY_CLIENT_SECRET=
# Cached at runtime by lib/ebay.ts — leave blank.
EBAY_OAUTH_TOKEN=

# Public app metadata
NEXT_PUBLIC_APP_NAME=Grab
NEXT_PUBLIC_APP_TAGLINE=Shoppers Insider

# Local Prophet/pytrends FastAPI microservice (pnpm ml)
FORECAST_API_URL=http://127.0.0.1:8000
